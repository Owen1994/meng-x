.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 50% 20%, #2B2150 0%, #16122B 60%);
}

.moon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C9B3F0 0%, #7C5CBF 100%);
  box-shadow: 0 0 80rpx rgba(155, 126, 222, 0.6);
  margin-bottom: 60rpx;
}

.title {
  font-size: 64rpx;
  font-weight: 600;
  letter-spacing: 12rpx;
  background: linear-gradient(135deg, #E8DFF9, #B39CE8);
  -webkit-background-clip: text;
  color: transparent;
}

.slogan {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #9B8FC4;
  letter-spacing: 4rpx;
}

.badge {
  margin-top: 80rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(155, 126, 222, 0.4);
  font-size: 22rpx;
  color: #7C5CBF;
}
